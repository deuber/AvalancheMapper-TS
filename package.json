{
  "name": "avalanche-mapper-ts",
  "version": "2.0.0",
  "description": "Extract GPS coordinates from avalanche-site photos and pin them on a topo map. TypeScript rewrite of AvalancheMapper.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "piexifjs": "^1.0.6",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
